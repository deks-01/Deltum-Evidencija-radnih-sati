      <div class="grid-2">
        <div>
          <label>Tvornički prednapunjena duljina (m)</label>
          <input type="number" id="prechargedLength" value="5" step="0.5" oninput="calcFreon()">
        </div>
        <div>
          <label>Tvornička norma nadopune (g/m)</label>
          <input type="number" id="gasPerMeter" value="15" step="1" oninput="calcFreon()">
        </div>
      </div>

      <div class="result-box">
        <div class="result-title">Potrebna dodatna količina plina:</div>
        <div class="result-value" id="freonResult">0 g</div>
        <div style="font-size:12px; color:var(--text-muted); margin-top:6px;" id="freonNote">Za rute kraće od prednapunjene duljine nije potrebna nadopuna.</div>
