        <option value="Servis i održavanje klima">Servis i održavanje klima</option>
        <option value="Dizalica topline">Dizalica topline (montaža/puštanje)</option>
        <option value="Elektroinstalacije - grubi radovi">Elektroinstalacije - grubi radovi (štemanje/cijevi)</option>
        <option value="Elektroinstalacije - fina montaža">Elektroinstalacije - fina montaža (utičnice/ormari)</option>
        <option value="Grijanje i vodovodne instalacije">Grijanje i vodovodne instalacije</option>
        <option value="Hitne intervencije i terenski izvid">Hitne intervencije i terenski izvid</option>
      </select>

      <label>Utrošeni materijal i tehničke bilješke</label>
      <textarea id="logMaterials" rows="3" placeholder="npr. 8m Cu cijevi 1/4-3/8, konzola 450mm, 0.45kg R32 freona, 3 automatska osigurača B16..."></textarea>

