      <div class="result-box">
        <div class="result-title">Procijenjeni pad napona (230V jednofazno):</div>
        <div class="result-value" id="voltageDropResult">1.82 % (4.18 V)</div>
        <div style="font-size:12px; color:var(--text-muted); margin-top:6px;" id="voltageDropNote">Dopušteni pad napona za instalacije iznosi do 3% (rasvjeta) odnosno do 5% (ostala trošila).</div>
      </div>
