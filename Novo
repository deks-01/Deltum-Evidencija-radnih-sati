      </div>
      <input type="text" id="searchMaterial" placeholder="🔍 Pretraži materijal (npr. bakar, nosač, kabel)..." oninput="filterMaterials()">
      <div id="materialsList" style="display:grid; grid-template-columns:1fr; gap:8px;"></div>
    </section>

    <!-- TAB 6: UPRAVLJANJE DJELATNICIMA (ADMIN) -->
    <section id="tab-radnici" class="card" style="display:none;">
      <div class="card-header-line">
        <h3 class="card-title">👥 Upravljanje djelatnicima (Admin)</h3>
      </div>

      <h4 style="font-size:14px; font-weight:700; margin-bottom:12px; color:#38bdf8;">Dodaj novog djelatnika u bazu</h4>
      <div class="grid-2">
        <div>
          <label>Ime i prezime</label>
          <input type="text" id="newWorkerName" placeholder="npr. Ivan Horvat">
        </div>
        <div>
          <label>Korisničko ime za prijavu</label>
          <input type="text" id="newWorkerUser" placeholder="npr. ivan" autocapitalize="none">
        </div>
      </div>
      <label>Lozinka</label>
      <input type="text" id="newWorkerPass" placeholder="npr. deltum2026">

      <button class="btn btn-primary" onclick="addNewWorker()">➕ Spremi radnika u sustav</button>

      <h4 style="font-size:13px; font-weight:700; margin:24px 0 12px 0; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em;">Aktivni djelatnici i lozinke</h4>
      <div id="workersList"></div>
    </section>
  </main>

  <!-- SKRIPTA I POVEZIVANJE S FIREBASE-OM -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-app.js";
    import { 
      getFirestore, collection, addDoc, onSnapshot, setDoc, doc, updateDoc, deleteDoc 
    } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-firestore.js";

    // Deltum d.o.o. službena konfiguracija
    const firebaseConfig = {
      apiKey: "AIzaSyCM6GdJsc2Lx_bG0qL7M4F8YpummlIM9YM",
      authDomain: "deltum-evidencija-radnih-sati.firebaseapp.com",
      projectId: "deltum-evidencija-radnih-sati",
      storageBucket: "deltum-evidencija-radnih-sati.firebasestorage.app",
      messagingSenderId: "216380213836",
      appId: "1:216380213836:web:f99ea22e524e97cbd802e9"
    };

    // Početni djelatnici (fallback baza u slučaju rada bez mreže)
    const initialWorkers = [
      { docId: "dejan", id: "dejan", name: "Dejan Cikoš", user: "dejan", pass: "123", role: "admin" },
      { docId: "melita", id: "melita", name: "Melita", user: "melita", pass: "123", role: "worker" },
      { docId: "alen", id: "alen", name: "Alen Ormanec", user: "alen", pass: "Ormanec-1986", role: "worker" }
    ];

    let db = null;
    let currentUser = null;
    let allWorkers = [...initialWorkers];
    let allLogs = [];

    // Inicijalizacija baze s automatskim sigurnim prijelazom
    try {
      const app = initializeApp(firebaseConfig);
      db = getFirestore(app);
      
      // Sinkronizacija djelatnika
      const workersCol = collection(db, "workers");
      onSnapshot(workersCol, (snapshot) => {
        if (!snapshot.empty) {
          const loaded = [];
          snapshot.forEach(docSnap => loaded.push({ docId: docSnap.id, ...docSnap.data() }));
          allWorkers = loaded;
        } else {
          // Ako je baza prazna, postavi početne radnike
          initialWorkers.forEach(w => setDoc(doc(db, "workers", w.id), w));
        }
        renderWorkersList();
      }, (err) => {
        console.warn("Lokalni način za radnike:", err);
        renderWorkersList();
      });

      // Sinkronizacija radnih naloga
      const logsCol = collection(db, "work_logs");
      onSnapshot(logsCol, (snapshot) => {
        allLogs = [];
        snapshot.forEach(docSnap => allLogs.push({ docId: docSnap.id, ...docSnap.data() }));
        renderLogs();
      }, (err) => {
        console.warn("Lokalni način za radne naloge:", err);
      });

    } catch (e) {
      console.warn("Rad u izvanmrežnom načinu rada:", e);
      renderWorkersList();
    }

    // Prijava
    window.handleLogin = function() {
      const u = document.getElementById("loginUsername").value.trim().toLowerCase();
      const p = document.getElementById("loginPassword").value.trim();
      const err = document.getElementById("loginError");

      const found = allWorkers.find(w => w.user && w.user.toLowerCase() === u && w.pass === p);
      if (found) {
        currentUser = found;
        err.style.display = "none";
        document.getElementById("loginScreen").style.display = "none";
        document.getElementById("appScreen").style.display = "block";
        document.getElementById("userHeader").style.display = "flex";
        document.getElementById("loggedUserName").innerText = found.name;
        
        if (found.role === "admin" || found.user === "dejan") {
          document.getElementById("adminTabBtn").style.display = "inline-flex";
        }
        
        document.getElementById("logDate").valueAsDate = new Date();
        renderLogs();
        calcFreon();
        calcVoltageDrop();
        renderMaterialsList();
      } else {
        err.style.display = "block";
      }
    };

    // Odjava
    window.logout = function() {
      currentUser = null;
      document.getElementById("loginScreen").style.display = "flex";
      document.getElementById("appScreen").style.display = "none";
      document.getElementById("userHeader").style.display = "none";
      document.getElementById("adminTabBtn").style.display = "none";
    };

    // Spremanje unosa u evidenciju
    window.saveWorkLog = async function() {
      const date = document.getElementById("logDate").value;
      const site = document.getElementById("logSite").value.trim();
      const hours = document.getElementById("logHours").value;
      const type = document.getElementById("logType").value;
      const materials = document.getElementById("logMaterials").value.trim();

      if (!date || !site || !hours) {
        alert("Molimo unesite datum, naziv gradilišta i broj sati.");
        return;
      }

      const entry = {
        workerName: currentUser.name,
        workerUser: currentUser.user,
        date, site, hours: parseFloat(hours), type, materials,
        createdAt: new Date().toISOString()
      };

      if (db) {
        try {
          await addDoc(collection(db, "work_logs"), entry);
        } catch (e) {
          allLogs.push(entry);
          renderLogs();
        }
      } else {
        allLogs.push(entry);
        renderLogs();
      }

      alert("Unos uspješno zabilježen!");
      document.getElementById("logSite").value = "";
      document.getElementById("logHours").value = "";
      document.getElementById("logMaterials").value = "";
      switchTab("pregled");
    };

    // Render liste evidencije
    function renderLogs() {
      const listDiv = document.getElementById("logsList");
      if (!listDiv) return;
      if (allLogs.length === 0) {
        listDiv.innerHTML = "<p style='color:var(--text-muted); font-size:13px;'>Nema zabilježenih unosa u sustavu.</p>";
        return;
      }

      let logs = [...allLogs].sort((a, b) => new Date(b.date) - new Date(a.date));
      let html = "";
      logs.forEach(item => {
        html += `
          <div class="log-item">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:6px;">
              <div>
                <div style="font-weight:800; font-size:15px; letter-spacing:-0.01em;">${item.site}</div>
                <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">
                  📅 ${item.date} • <strong style="color:#38bdf8;">${item.workerName}</strong>
                </div>
              </div>
              <span class="badge badge-primary">${item.hours} h</span>
            </div>
            <div style="font-size:13px; color:#cbd5e1; margin-top:6px;">🔧 ${item.type}</div>
            ${item.materials ? `<div style="font-size:12px; color:#93c5fd; margin-top:8px; background:rgba(2, 132, 199, 0.1); padding:8px 12px; border-radius:8px; border:1px solid rgba(2, 132, 199, 0.2);">📦 <strong>Materijal:</strong> ${item.materials}</div>` : ''}
          </div>
        `;
      });
      listDiv.innerHTML = html;
    }

    // Dodavanje novog djelatnika
    window.addNewWorker = async function() {
      const name = document.getElementById("newWorkerName").value.trim();
      const user = document.getElementById("newWorkerUser").value.trim().toLowerCase();
      const pass = document.getElementById("newWorkerPass").value.trim();

      if (!name || !user || !pass) {
        alert("Popunite sva polja za novog djelatnika.");
        return;
      }

      const newObj = { id: user, name, user, pass, role: "worker" };
      if (db) {
        try {
          await setDoc(doc(db, "workers", user), newObj);
        } catch (e) {
          allWorkers.push({ docId: user, ...newObj });
          renderWorkersList();
        }
      } else {
        allWorkers.push({ docId: user, ...newObj });
        renderWorkersList();
      }

      alert(`Djelatnik ${name} je uspješno dodan!`);
      document.getElementById("newWorkerName").value = "";
      document.getElementById("newWorkerUser").value = "";
      document.getElementById("newWorkerPass").value = "";
    };

    // Uređivanje lozinke
    window.editWorkerPass = async function(docId, currentPass, name) {
      const novaLozinka = prompt(`Nova lozinka za djelatnika: ${name}`, currentPass);
      if (novaLozinka !== null && novaLozinka.trim() !== "") {
        if (db) {
          try {
            await updateDoc(doc(db, "workers", docId), { pass: novaLozinka.trim() });
          } catch (e) {
            const w = allWorkers.find(x => x.docId === docId);
            if (w) w.pass = novaLozinka.trim();
            renderWorkersList();
          }
        } else {
          const w = allWorkers.find(x => x.docId === docId);
          if (w) w.pass = novaLozinka.trim();
          renderWorkersList();
        }
        alert("Lozinka je uspješno ažurirana!");
      }
    };

    // Brisanje djelatnika
    window.deleteWorker = async function(docId, name, username) {
      if (username === "dejan") {
        alert("Glavni administratorski račun (dejan) ne može se obrisati.");
        return;
      }

      if (confirm(`Želite li trajno ukloniti djelatnika ${name} (${username})?`)) {
        if (db) {
          try {
            await deleteDoc(doc(db, "workers", docId));
          } catch (e) {
            allWorkers = allWorkers.filter(x => x.docId !== docId);
            renderWorkersList();
          }
        } else {
          allWorkers = allWorkers.filter(x => x.docId !== docId);
          renderWorkersList();
        }
        alert(`Djelatnik ${name} je obrisan.`);
      }
    };

    // Prikaz popisa djelatnika s opcijama
    function renderWorkersList() {
      const div = document.getElementById("workersList");
      if (!div) return;
      let html = "";
      allWorkers.forEach(w => {
        const isDejan = w.user === "dejan";
        html += `
          <div class="worker-row">
            <div>
              <div style="font-weight:700; font-size:14px;">${w.name} <span style="font-size:12px; color:var(--text-muted); font-weight:400;">(${w.user})</span></div>
              <div style="font-size:12px; color:#38bdf8; font-family:var(--font-mono); margin-top:2px;">
                Lozinka: <span style="color:#fff; font-weight:700;">${w.pass}</span>
              </div>
            </div>
            <div class="worker-actions">
              <button class="action-icon-btn" onclick="editWorkerPass('${w.docId}', '${w.pass}', '${w.name}')">
                ✏️ Izmijeni lozinku
              </button>
              ${!isDejan ? `
                <button class="action-icon-btn delete" onclick="deleteWorker('${w.docId}', '${w.name}', '${w.user}')">
                  🗑️ Obriši
                </button>
              ` : ''}
            </div>
          </div>
        `;
      });
      div.innerHTML = html;
    }

    // KALKULATOR FREONA
    window.calcFreon = function() {
      const len = parseFloat(document.getElementById("pipeLength").value) || 0;
      const pre = parseFloat(document.getElementById("prechargedLength").value) || 0;
      const rate = parseFloat(document.getElementById("gasPerMeter").value) || 15;
      
      const resEl = document.getElementById("freonResult");
      const noteEl = document.getElementById("freonNote");

      if (len > pre) {
        const extra = Math.round((len - pre) * rate);
        resEl.innerText = `${extra} g`;
        noteEl.innerText = `Potrebno je dopuniti ${extra} g plina za dodatnih ${(len - pre).toFixed(1)} metara cjevovoda.`;
      } else {
        resEl.innerText = `0 g`;
        noteEl.innerText = `Duljina je unutar tvorničke prednapune (${pre} m). Nadopuna nije potrebna.`;
      }
    };

    // KALKULATOR PADA NAPONA
    window.calcVoltageDrop = function() {
      const P = parseFloat(document.getElementById("elecPower").value) || 0; // kW
      const L = parseFloat(document.getElementById("elecLength").value) || 0; // m
      const S = parseFloat(document.getElementById("elecSection").value) || 2.5; // mm2
      const U = 230; // V

      const I = (P * 1000) / U;
      const gamma = 56; // bakar m/(ohm*mm2)
      const deltaU = (2 * L * I) / (gamma * S);
      const percentage = (deltaU / U) * 100;

      const resEl = document.getElementById("voltageDropResult");
      const noteEl = document.getElementById("voltageDropNote");

      resEl.innerText = `${percentage.toFixed(2)} % (${deltaU.toFixed(2)} V)`;
      if (percentage <= 3) {
        resEl.style.color = "#34d399";
        noteEl.innerText = "Pad napona je u idealnim granicama (ispod 3%).";
      } else if (percentage <= 5) {
        resEl.style.color = "#fbbf24";
        noteEl.innerText = "Pad napona je prihvatljiv za pogonska trošila (3% do 5%).";
      } else {
        resEl.style.color = "#f87171";
        noteEl.innerText = "Upozorenje: Pad napona prelazi 5%! Preporučuje se veći presjek vodiča.";
      }
    };

    // ŠIFRARNIK MATERIJALA
    const materialsDatabase = [
      { cat: "Klimatizacija", name: "Bakar Cu 1/4\" + 3/8\" u izolaciji", unit: "metar" },
      { cat: "Klimatizacija", name: "Bakar Cu 1/4\" + 1/2\" u izolaciji", unit: "metar" },
      { cat: "Klimatizacija", name: "Zidni nosač za vanjsku jedinicu 450 mm", unit: "par" },
      { cat: "Klimatizacija", name: "Antivibracijske gume (amortizeri)", unit: "set 4 kom" },
      { cat: "Klimatizacija", name: "Kondenzacijsko crijevo fi 16/18 mm", unit: "metar" },
      { cat: "Klimatizacija", name: "Kanalica za instalaciju klime 60x45 mm", unit: "metar" },
      { cat: "Klimatizacija", name: "Freon R32 boca", unit: "kg" },
      { cat: "Elektro", name: "Kabel NYM-J (PP-Y) 3x1.5 mm²", unit: "metar" },
      { cat: "Elektro", name: "Kabel NYM-J (PP-Y) 3x2.5 mm²", unit: "metar" },
      { cat: "Elektro", name: "Kabel NYM-J (PP-Y) 5x2.5 mm²", unit: "metar" },
      { cat: "Elektro", name: "Automatski osigurač 1P B16A", unit: "kom" },
      { cat: "Elektro", name: "Automatski osigurač 1P B10A", unit: "kom" },
      { cat: "Elektro", name: "FID sklopka 40/0.03A 4-polna", unit: "kom" }
    ];

    function renderMaterialsList(filterText = "") {
      const div = document.getElementById("materialsList");
      if (!div) return;
      const filtered = materialsDatabase.filter(m => 
        m.name.toLowerCase().includes(filterText.toLowerCase()) || 
        m.cat.toLowerCase().includes(filterText.toLowerCase())
      );

      div.innerHTML = filtered.map(m => `
        <div style="background:var(--card-sub); border:1px solid var(--card-border); padding:10px 14px; border-radius:10px; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <div style="font-weight:700; font-size:13px;">${m.name}</div>
            <div style="font-size:11px; color:var(--text-muted);">${m.cat}</div>
          </div>
          <span class="badge badge-primary">${m.unit}</span>
        </div>
      `).join("");
    }
    window.filterMaterials = () => renderMaterialsList(document.getElementById("searchMaterial").value);

    // IZVOZ SAŽETKA EVIDENCIJE
    window.exportLogsToText = function() {
      if (allLogs.length === 0) {
        alert("Nema unosa za izvoz.");
        return;
      }
      let report = "DELTUM d.o.o. - EVIDENCIJA RADNIH SATI\n====================================\n\n";
      allLogs.forEach(l => {
        report += `Datum: ${l.date} | Radnik: ${l.workerName} | Sati: ${l.hours}h\nGradilište: ${l.site}\nKategorija: ${l.type}\nMaterijal: ${l.materials || '-'}\n------------------------------------\n`;
      });
      navigator.clipboard.writeText(report);
      alert("Cjeloviti sažetak radova je kopiran u međuspremnik!");
    };

    // NAVIGACIJA TABOVA
    window.switchTab = function(tab) {
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      document.querySelectorAll("main section").forEach(s => s.style.display = "none");
      document.getElementById(`tab-${tab}`).style.display = "block";
      
      const activeBtn = Array.from(document.querySelectorAll(".tab-btn")).find(b => b.getAttribute("onclick").includes(tab));
      if (activeBtn) activeBtn.classList.add("active");
    };

    // MODAL FUNKCIJE
    window.openCompanyModal = () => document.getElementById("companyModal").classList.add("open");
    window.closeCompanyModal = () => document.getElementById("companyModal").classList.remove("open");
    window.copyCompanyInfo = () => {
      const text = "Deltum d.o.o.\nĐure Sudete 5, 48326 Virje\nOIB: 40386639373\nPDV ID: HR40386639373";
      navigator.clipboard.writeText(text);
      alert("Podaci o tvrtki Deltum d.o.o. su kopirani!");
    };
  </script>
