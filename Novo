      </div>
      
      <div class="grid-2">
        <div>
          <label>Tip rashladnog sredstva</label>
          <select id="gasType">
            <option value="R32">R32 (tvornički ~15g/m)</option>
            <option value="R410A">R410A (tvornički ~20g/m)</option>
